# Copier ce fichier en .env (meme dossier) et le remplir. Ne jamais versionner ni partager .env : il contient votre cle.

# Cle API Kimi (console : https://platform.kimi.ai)
MOONSHOT_API_KEY=
# Modele : verifier l'identifiant exact avec « node scripts/kimi.mjs modeles » (ex. kimi-k3.1-pro)
KIMI_MODEL=kimi-k3.1-pro

# Prix par million de tokens (page de tarification de la console Kimi)
KIMI_PRICE_IN=
KIMI_PRICE_CACHE_IN=
KIMI_PRICE_OUT=
KIMI_DEVISE=USD

# Effort de raisonnement de la serie K3 : low (rapide, par defaut) | high | max (tres long)
KIMI_REASONING_EFFORT=low

# Optionnels
# KIMI_MAX_TOKENS=131072
# KIMI_TIMEOUT_MIN=30
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Fichier de prospection (lecture seule) : chemin absolu de votre copie synchronisee du fichier Excel,
# ou chemin relatif au kit (ex. prospects/Prospection.xlsx), sans guillemets. Sous Windows : C:/Users/vous/... ou C:\Users\vous\...
PROSPECTS_XLSX=

# Facultatif : chemin du navigateur pour les captures (sinon Chrome, Edge ou Chromium detecte automatiquement)
# CHROME_PATH=
